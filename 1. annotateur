# création des colonnes de validation
data$Check_scAnnoX <- data$scAnnoX == data$consensus_predicted
data$Check_SingleR <- data$SingleR_main == data$consensus_predicted
data$Check_scPred  <- data$scpred_CellType_all == data$consensus_predicted

# transforme en "Match" / "Mismatch" 
for(col in c("scAnnoX", "SingleR_main", "scpred_CellType_all")) {
  
  # On crée le nom de la nouvelle colonne de check
  new_col_name <- paste0("Check_", col)
  
  # On compare les vecteurs de manière propre
  # On utilise [[ , 1]] pour être sûr d'extraire le vecteur du data.frame
  is_match <- data[[col, drop = TRUE]] == data[["consensus_predicted", drop = TRUE]]
  
  # On gère les NA (au cas où un outil n'a pas classé certaines cellules)
  is_match[is.na(is_match)] <- FALSE
  
  # On assigne le résultat
  data[[new_col_name]] <- ifelse(is_match, "Match", "Mismatch")
}
