#9.Analyse differentielle (CR vs NR)

#comparaison globale

Idents(seu) <- "reponse"
de_resp <- FindMarkers(
  seu,
  ident.1 = "NR",
  ident.2 = "CR"
)

#par cluster

de_cluster <- FindMarkers(
  seu,
  ident.1 = "NR",
  ident.2 = "CR",
  subset.ident = "HSC-like"
)

#10. scores de voies biologiques

#addmodulescore (stat5 exemple)

stat5_genes <- c("STAT5A", "STAT5B", "S0CS2", "PIM1")

seu <- AddModuleScore(
  seu,
  features = list(stat5_genes),
  name = "STAT5_score"
)

#visualisation

FeaturePlot(seu, features = "STAT5_score1")
Vlnplot(seu, features = "STAT5_score1", group.by = "response")

#11. comparaison BM vs PB / pre vs post

DimPlot(seu, group.by = "compartment")
DimPlot(seu, group.by = "timepoint")

VlnPlot(seu, features = "STAT5_score1", group.by = "compartment")

#12. sauvegarde

saveRDS(seu, file = "AML_seurat_object.rds")
